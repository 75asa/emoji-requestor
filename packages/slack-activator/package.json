{
  "name": "slack-activator",
  "version": "0.0.0",
  "private": true,
  "description": "activate your Slack online status.",
  "author": "75asa <75asa.me@gmail.com>",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/main.js",
    "start:setAuto": "node dist/main.js --mode=auto",
    "start:setAway": "node dist/main.js --mode=away",
    "dev:setAuto": "tsx src/main.ts --mode=auto",
    "dev:setAway": "tsx src/main.ts --mode=away"
  },
  "dependencies": {
    "@slack/web-api": "^8.1.1",
    "dotenv": "^18.0.1",
    "ts-command-line-args": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
