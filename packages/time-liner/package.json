    "start": "node lib/index.js",
    "ngrok": "ngrok http 3333"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.2.0",
    "@slack/web-api": "^8.2.0",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
