{
  "name": "time-liner",
  "version": "2.0.0",
  "private": true,
  "description": "指定の Slack チャンネルの投稿を別のチャンネルに転送する Bolt アプリ",
  "license": "ISC",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
