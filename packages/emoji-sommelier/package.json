{
  "name": "emoji-sommelier",
  "version": "1.0.0",
  "private": true,
  "description": "Slack のカスタム絵文字を Kibela などの他サービスへ同期する",
  "author": "Asato Nago <nago@tam-bourine.co.jp>",
  "license": "MIT",
  "main": "dest/index.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dest/index.js",
    "build:remote": "make gcr-push && make gcr-deploy",
    "logs": "gcloud app logs read",
    "logs:tail": "gcloud app logs tail"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.1.0",
    "@slack/web-api": "^8.1.1",
    "dotenv": "^18.0.1",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.6",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "@types/node-fetch": "^2.6.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
