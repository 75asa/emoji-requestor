{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "sourceMap": true,
    "outDir": "./dest",
    "strict": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "lib": [
      "ES2022"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "typeRoots": [
    "node_modules/@types"
  ],
  "rootDir": "src",
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compileOnSave": true,
  "types": [
    "src/types/*"
  ]
}
